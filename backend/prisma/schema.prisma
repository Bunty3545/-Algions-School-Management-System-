datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         String    // "ADMIN", "TEACHER", "GUARDIAN", "STUDENT"
  phone        String?
  avatar       String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  teacherProfile  TeacherProfile?
  guardianProfile GuardianProfile?
  studentProfile  StudentProfile?

  recordedAttendances AttendanceRecord[] @relation("RecordedBy")
  evaluatedMarks      ExamMark[]         @relation("EvaluatedBy")
  receivedPayments    FeePayment[]       @relation("ReceivedBy")
  auditLogs           AuditLog[]
}

model TeacherProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeId     String   @unique
  specialization String?
  joiningDate    DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  allocations ClassSubjectTeacher[]
}

model AcademicClass {
  id        String    @id @default(cuid())
  name      String    @unique
  code      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  sections Section[]
}

model Section {
  id         String        @id @default(cuid())
  name       String
  classId    String
  class      AcademicClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  roomNumber String?
  capacity   Int           @default(40)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  students           StudentProfile[]
  teacherAllocations ClassSubjectTeacher[]
  attendanceRecords  AttendanceRecord[]
  examSchedules      ExamSchedule[]

  @@unique([classId, name])
}

model Subject {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  allocations   ClassSubjectTeacher[]
  examSchedules ExamSchedule[]
}

model ClassSubjectTeacher {
  id               String         @id @default(cuid())
  sectionId        String
  section          Section        @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subjectId        String
  subject          Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherProfileId String
  teacherProfile   TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  academicYear     String         @default("2024-2025")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([sectionId, subjectId])
}

model StudentProfile {
  id              String   @id @default(cuid())
  userId          String?  @unique
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  admissionNumber String   @unique
  firstName       String
  lastName        String
  dateOfBirth     String?
  gender          String?
  rollNumber      Int?
  sectionId       String
  section         Section  @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  guardians         StudentGuardianRelation[]
  attendanceRecords AttendanceRecord[]
  examMarks         ExamMark[]
  feeInvoices       FeeInvoice[]
}

model GuardianProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  relationship String   @default("PARENT")
  occupation   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  students StudentGuardianRelation[]
}

model StudentGuardianRelation {
  id                String          @id @default(cuid())
  studentId         String
  student           StudentProfile  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardianProfileId String
  guardianProfile   GuardianProfile @relation(fields: [guardianProfileId], references: [id], onDelete: Cascade)
  isPrimary         Boolean         @default(true)
  createdAt         DateTime        @default(now())

  @@unique([studentId, guardianProfileId])
}

model AttendanceRecord {
  id           String         @id @default(cuid())
  studentId    String
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sectionId    String
  section      Section        @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  date         String         // Format: YYYY-MM-DD
  session      String         @default("FULL_DAY") // "MORNING", "AFTERNOON", "FULL_DAY"
  status       String         // "PRESENT", "ABSENT", "LATE", "EXCUSED"
  remarks      String?
  recordedById String?
  recordedBy   User?          @relation("RecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([studentId, date, session])
  @@index([sectionId, date])
  @@index([studentId, date])
}

model GradingScale {
  id        String      @id @default(cuid())
  name      String      @unique
  isDefault Boolean     @default(true)
  rules     GradeRule[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model GradeRule {
  id             String       @id @default(cuid())
  gradingScaleId String
  gradingScale   GradingScale @relation(fields: [gradingScaleId], references: [id], onDelete: Cascade)
  grade          String
  minScore       Float
  maxScore       Float
  gradePoint     Float
  description    String?

  @@unique([gradingScaleId, grade])
}

model Exam {
  id           String         @id @default(cuid())
  title        String
  term         String
  academicYear String         @default("2024-2025")
  startDate    String
  endDate      String
  status       String         @default("SCHEDULED")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  schedules ExamSchedule[]
}

model ExamSchedule {
  id        String   @id @default(cuid())
  examId    String
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  sectionId String
  section   Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  examDate  String
  maxMarks  Float    @default(100)
  passMarks Float    @default(40)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  marks ExamMark[]

  @@unique([examId, sectionId, subjectId])
}

model ExamMark {
  id             String         @id @default(cuid())
  examScheduleId String
  examSchedule   ExamSchedule   @relation(fields: [examScheduleId], references: [id], onDelete: Cascade)
  studentId      String
  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  marksObtained  Float
  isAbsent       Boolean        @default(false)
  remarks        String?
  evaluatedById  String?
  evaluatedBy    User?          @relation("EvaluatedBy", fields: [evaluatedById], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([examScheduleId, studentId])
  @@index([studentId])
}

model FeeCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isRecurring Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FeeInvoice {
  id            String         @id @default(cuid())
  invoiceNumber String         @unique
  studentId     String
  student       StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title         String
  category      String         @default("Tuition")
  amount        Float
  amountPaid    Float          @default(0)
  amountDue     Float
  dueDate       String
  status        String         @default("PENDING") // PENDING, PARTIALLY_PAID, PAID, OVERDUE, CANCELLED
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  payments FeePayment[]
  @@index([studentId])
}

model FeePayment {
  id            String     @id @default(cuid())
  paymentNumber String     @unique
  invoiceId     String
  invoice       FeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount        Float
  paymentMethod String     @default("ONLINE_SIMULATED") // ONLINE_SIMULATED, CASH, BANK_TRANSFER, CHEQUE
  referenceNote String?
  transactionId String?
  paidAt        DateTime   @default(now())
  receivedById  String?
  receivedBy    User?      @relation("ReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)

  @@index([invoiceId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([entityType])
}
